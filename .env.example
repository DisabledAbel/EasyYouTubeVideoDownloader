# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARCHIVE_API_KEY=
ARCHIVE_DATA_DIR=data
# Exact frontend origins, comma-separated, when hosting the frontend separately.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_ARCHIVE_BYTES=536870912
MAX_DURATION_SECONDS=7200
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_JOBS=20
RETENTION_HOURS=24
# Optional public frontend build variable. Never put a key or password here.
# ARCHIVE_API_URL=https://your-backend.example.com
